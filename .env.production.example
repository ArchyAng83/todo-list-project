# Copy to .env.production, fill in real values, and never commit the copy.
# The file is passed explicitly:
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# Generate strong values with: openssl rand -base64 32

POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=change-me-long-random-password

APP_PORT=8080
TODOLIST_IMAGE=todolist:latest
TODOLIST_MIGRATIONS_IMAGE=todolist-migrations:latest

# Public host names accepted by the Host header filter. Semicolon-separated.
# Leaving this as * is convenient for a first boot but lets a spoofed Host
# header through; set it before the app is exposed.
ALLOWED_HOSTS=example.com;www.example.com

AUTH_RATE_LIMIT_PERMIT_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP. Leave SMTP_HOST empty to keep the logging sender: reminders will be
# processed but only written to the log. Set REMINDERS_ENABLED=false to stop
# the dispatcher entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=TodoList

REMINDERS_ENABLED=true

# Terminal reminders older than this many days are deleted by the retention
# worker; cleanup runs every REMINDERS_CLEANUP_INTERVAL_HOURS hours.
REMINDERS_RETENTION_DAYS=30
REMINDERS_CLEANUP_INTERVAL_HOURS=24

# Behind a TLS-terminating proxy set FORWARDED_HEADERS_ENABLED=true and add the
# proxy network to a compose override, for example:
#   services:
#     app:
#       environment:
#         ForwardedHeaders__KnownNetworks__0: 172.16.0.0/12
# Without a trust list the middleware keeps its loopback-only defaults.
FORWARDED_HEADERS_ENABLED=false
FORWARDED_HEADERS_FORWARD_LIMIT=1
