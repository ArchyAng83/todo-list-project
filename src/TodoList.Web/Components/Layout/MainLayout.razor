@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject IServiceScopeFactory ScopeFactory
@inject ICurrentUserProvider CurrentUser
@inject ThemePreference ThemePreference
@inject IJSRuntime JS

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <a href="#main-content" class="skip-link">@L["SkipToContent"]</a>
    <MudAppBar Elevation="1" Dense="true">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               aria-label="@L["OpenMenu"]"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            </Authorized>
        </AuthorizeView>
        <MudText Typo="Typo.h6" Class="ml-2 app-brand-text">
            <a href="/" class="app-brand">@L["AppName"]</a>
        </MudText>
        <MudSpacer />
        <CultureSwitcher />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="ml-4 mr-2 hide-xs">@context.User.Identity?.Name</MudText>
                <MudButton Href="/account/logout"
                           Color="Color.Inherit"
                           Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Logout">
                    @L["SignOut"]
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/account/login" Color="Color.Inherit" Variant="Variant.Text">
                    @L["SignIn"]
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen"
                       Elevation="1"
                       Breakpoint="Breakpoint.Sm"
                       ClipMode="DrawerClipMode.Always">
                <MudNavMenu Class="mt-2" aria-label="@L["MainNavigation"]">
                    <MudNavLink Href="/tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Checklist">
                        @L["Tasks"]
                    </MudNavLink>
                    <MudNavLink Href="/board" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">
                        @L["Board"]
                    </MudNavLink>
                    <MudNavLink Href="/calendar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">
                        @L["Calendar"]
                    </MudNavLink>
                    <MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder">
                        @L["Projects"]
                    </MudNavLink>
                    <MudNavLink Href="/tags" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Label">
                        @L["Tags"]
                    </MudNavLink>
                    <MudNavLink Href="/data" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">
                        @L["Data"]
                    </MudNavLink>
                    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                        @L["Settings"]
                    </MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            <div id="main-content" tabindex="-1">
                @Body
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _systemDarkMode;

    protected override async Task OnInitializedAsync()
    {
        ThemePreference.Changed += OnThemeChanged;
        await LoadThemeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _systemDarkMode = await JS.InvokeAsync<bool>("todoListTheme.prefersDark");
            ApplyTheme();
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; nothing to apply.
        }
        catch (InvalidOperationException)
        {
            // Prerendering has no JavaScript runtime.
        }
    }

    private async Task LoadThemeAsync()
    {
        var user = await CurrentUser.GetAsync();

        if (user is null)
        {
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var service = scope.ServiceProvider.GetRequiredService<UserSettingsService>();
        var settings = await service.GetAsync(user);

        if (settings is not null)
        {
            ThemePreference.Set(settings.Theme);
        }

        ApplyTheme();
    }

    private void OnThemeChanged()
    {
        ApplyTheme();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyTheme()
    {
        _isDarkMode = ThemePreference.Theme switch
        {
            "dark" => true,
            "light" => false,
            _ => _systemDarkMode
        };
    }

    public void Dispose() => ThemePreference.Changed -= OnThemeChanged;
}
