@page "/"
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AppName"]</PageTitle>

<section class="hero">
    <MudText Typo="Typo.h2" HtmlTag="h1" Class="hero-title">@L["HeroTitle"]</MudText>
    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="hero-subtitle">@L["HeroSubtitle"]</MudText>

    <AuthorizeView>
        <Authorized>
            <MudButton Href="/tasks"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="mt-6">
                @L["GoToTasks"]
            </MudButton>
        </Authorized>
        <NotAuthorized>
            <div class="hero-actions">
                <MudButton Href="/account/register"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large">
                    @L["GetStarted"]
                </MudButton>
                <MudButton Href="/account/login"
                           Variant="Variant.Outlined"
                           Size="Size.Large">
                    @L["SignIn"]
                </MudButton>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</section>
