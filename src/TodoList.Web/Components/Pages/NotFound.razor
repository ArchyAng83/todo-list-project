@page "/not-found"
@layout AuthLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFoundTitle"] · @L["AppName"]</PageTitle>

<h1 class="auth-title">@L["NotFoundTitle"]</h1>
<p class="auth-subtitle">@L["NotFoundMessage"]</p>
<a class="auth-submit auth-submit-link" href="/">@L["BackToHome"]</a>
