@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ErrorPageTitle"]</PageTitle>

<h1 class="text-danger">@L["ErrorPageHeading"]</h1>
<h2 class="text-danger">@L["ErrorPageMessage"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["RequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["DevelopmentModeHeading"]</h3>
<p>
    @L["DevelopmentModeBody"]
</p>
<p>
    <strong>@L["DevelopmentModeWarning"]</strong>
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
