{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=todolist;Username=todolist;Password=${TODO_DB_PASSWORD}"
  },
  "Email": {
    "FromAddress": "no-reply@todolist.local",
    "FromName": "TodoList"
  },
  "Reminders": {
    "Enabled": true,
    "PollIntervalSeconds": 30,
    "BatchSize": 25
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
