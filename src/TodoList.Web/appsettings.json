{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=todolist;Username=todolist"
  },
  "DataProtection": {
    "ApplicationName": "TodoList",
    "KeysPath": ""
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1
  },
  "Auth": {
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "FromAddress": "no-reply@todolist.local",
    "FromName": "TodoList"
  },
  "Reminders": {
    "Enabled": true,
    "PollIntervalSeconds": 30,
    "BatchSize": 25,
    "RetentionDays": 30,
    "CleanupIntervalHours": 24
  },
  "SecurityHeaders": {
    "Enabled": true,
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
